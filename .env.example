# -----------------------------------------------------------------------------
# SECAMB - Sistema de Requisição de Licenciamento Ambiental (IFBA- Campus Seabra)
# Arquivo de Configuração Local (.env)
# -----------------------------------------------------------------------------

APP_NAME="SECAMB - Seabra"
APP_ENV=local
APP_KEY=key
APP_DEBUG=true
APP_TIMEZONE="America/Bahia"
APP_URL=http://localhost:8000
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=pt_BR
APP_FAKER_LOCALE=pt_BR

# Administrador inicial
ADMIN_NAME="Administrador do SECAMB"
ADMIN_EMAIL=admin@secamb.local
ADMIN_PASSWORD=change-me

# Aplicacao
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Banco de dados
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=secamb
DB_USERNAME=root
DB_PASSWORD=

# Sessao, fila e cache
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=database
CACHE_STORE=database
CACHE_PREFIX=

# E-mail
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="[EMAIL_ADDRESS]"
MAIL_FROM_NAME="SECAMB - Seabra"


# Arquivos e frontend
FILESYSTEM_DISK=local

VITE_APP_NAME="${APP_NAME}"

# Google OAuth (Login Social)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
